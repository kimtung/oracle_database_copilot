# Application
APP_NAME="DB Copilot"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_copilot
# POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/db_copilot

# MCP Server Gateway (Oracle MCP Server)
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=["-m", "oracle_mcp.server"]
MCP_SERVER_CWD=d:/2026/oracle_ai/oracle-mcp-server
ORACLE_USER=db_copilot_readonly
ORACLE_PASSWORD=ChangeMe_2026!
ORACLE_DSN=localhost:1521/ORCL

# Evidence Engine & Scheduler
ENABLE_SCHEDULER=true
COLLECTION_INTERVAL_MINUTES=5
BASELINE_RECALC_INTERVAL_HOURS=1
SQL_REGRESSION_MULTIPLIER=3.0
TABLESPACE_WARNING_THRESHOLD=80.0
TABLESPACE_CRITICAL_THRESHOLD=90.0
