# Application
APP_NAME="DB Copilot"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_copilot
# Database URL can be explicitly specified or computed from the above fields
# POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/db_copilot
